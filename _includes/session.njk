---
layout: base.njk
---
<h1>{{ title }}</h1>
<p class="meta">Session of {{ date }}</p>
{{ content | safe }}

{% if articles %}
<h2>Readings</h2>
<ul class="list">
{%- for name in articles %}
  {%- set a = collections.articles | findArticle(name) %}
  <li>
  {%- if a %}<a href="{{ a.url }}">{{ a.data.title }}</a> <span class="meta">{{ a.data.author }}{% if a.data.date %}, {{ a.data.date }}{% endif %}</span>
  {%- else %}{{ name }}{% endif -%}
  </li>
{%- endfor %}
</ul>
{% endif %}

{% if external %}
<h2>External links</h2>
<ul class="list">
{%- for item in external %}
  {%- for name, info in item %}
  <li>{% if info.source %}<a href="{{ info.source }}">{{ name }}</a>{% else %}{{ name }}{% endif %} <span class="meta">{{ info.author }}{% if info.date %}, {{ info.date }}{% endif %}</span></li>
  {%- endfor %}
{%- endfor %}
</ul>
{% endif %}

{% if suggestions %}
<h2>Suggestions</h2>
<ul class="list">
{%- for item in suggestions %}
  {%- for name, info in item %}
  <li>{% if info.source %}<a href="{{ info.source }}">{{ name }}</a>{% else %}{{ name }}{% endif %} <span class="meta">{{ info.author }}{% if info.date %}, {{ info.date }}{% endif %}</span></li>
  {%- endfor %}
{%- endfor %}
</ul>
{% endif %}
