---
layout: base.njk
---
{{ content | safe }}

<h2>Sessions</h2>
<ul class="list">
{%- for s in collections.sessions %}
  <li><a href="{{ s.url }}">{{ s.data.title }}</a> <span class="meta">{{ s.data.date }}</span></li>
{%- endfor %}
</ul>

<h2>All articles</h2>
<ul class="list">
{%- for a in collections.articles %}
  <li><a href="{{ a.url }}">{{ a.data.title }}</a> <span class="meta">{{ a.data.author }}{% if a.data.date %}, {{ a.data.date }}{% endif %}</span></li>
{%- endfor %}
</ul>
